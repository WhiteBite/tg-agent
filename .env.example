# Телеграм-креды для sync.py (https://my.telegram.org/apps)
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# Необязательно: телефон для неинтерактивного логина
# TELEGRAM_PHONE=+358401234567

# Необязательно: строковая сессия вместо файла (для контейнеров)
# TELEGRAM_SESSION_STRING=

# Необязательно: имя файла сессии без суффикса .session
# TELEGRAM_SESSION_NAME=/home/you/tg-agent/tg_agent_session

# Где лежит индекс (его читают server.py и sync.py)
TG_DB=/home/you/tg-agent/tg_index.sqlite

# 1 — добавить в MCP инструменты чтения напрямую из Telegram (всё ещё только чтение)
# TG_ALLOW_LIVE=1

# EXTRACT_PROVIDER=stub — stub | openai; без EXTRACT_KEY работает stub

# EXTRACT_URL=https://api.openai.com/v1

# EXTRACT_KEY=sk-...

# EXTRACT_MODEL=gpt-4o-mini

# EXTRACT_MAX_CHARS=60000 — бюджет промпта на прогон темы (20000 для медленных провайдеров)

# EXTRACT_TIMEOUT=240 — жёсткий дедлайн одного LLM-вызова в секундах

# EXTRACT_WORKERS=1 — параллельная дожёвка тем (6 — разумно для dashscope)

# DIGEST_TIMEOUT=240 — то же для дайджестов

# EXTRACT_URL=https://dashscope.aliyuncs.com/compatible-mode/v1 — пресет qwen (EXTRACT_MODEL=qwen3.8-flash)

# DIGEST_PROVIDER=openai — дайджесты тем же провайдером, что extract

# DIGEST_URL=https://api.openai.com/v1

# DIGEST_KEY=sk-...

# DIGEST_MODEL=gpt-4o-mini

# MEDIA_PROVIDER=stub — stub | openai

# MEDIA_URL=https://api.openai.com/v1

# MEDIA_KEY=sk-...

# MEDIA_MODEL=whisper-1

# MEMORY_EMBED_PROVIDER=openai — opt-in семантический слой памяти (MEMORY_EMBED_URL/KEY/MODEL)

# TG_ALLOW_SEND=1 — ВНИМАНИЕ: разрешает notify.py реально писать в твой Telegram (Saved Messages)

# TG_ALLOW_MANAGE=1  # разрешить агенту создавать и настраивать чаты (подтверждение на каждую операцию)

# TG_NOTIFY_CAP=10

# TG_EXPORT_PATH=/home/you/tg-agent/export.jsonl

# TG_BOT_TOKEN=123456:ABC... — ингест через Telegram Bot API (bot_ingest.py), читает в локальный индекс

# TG_BOT_URL=https://api.telegram.org

# NOTION_TOKEN=secret_... — экспорт в Notion (export.py --system notion)

# NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# NOTION_MAP={"title":"Name","body":"Notes","due_ts":"Due","status":"Status","owner":"Owner"}

# NOTION_KINDS=task,promise,approval

# NOTION_API_VERSION=2026-03-11

# NOTION_DRY=1 — показать, что уедет, без сети

# NOTION_RETRIES=3

# NOTION_BACKOFF=1,5,15

# NOTION_TIMEOUT=30
